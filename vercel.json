{
    "version": 2,
    "builds": [
        {
            "src": "api/index.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "api/index.ts"
        }
    ],
    "crons": [
        {
            "path": "/logros/actualizar-programados",
            "schedule": "0 3 * * *"
        }
    ]
}
